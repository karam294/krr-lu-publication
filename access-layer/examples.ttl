# Example queries for the access layer, in the SHACL vocabulary that
# sparql-llm and the SIB endpoints use: one sh:SPARQLExecutable per example,
# the question in rdfs:comment, the query in sh:select.
# Each shows one way our graph is asked (a kind of paper, a year, a name, a
# topic's field, an affiliation). None is a question of the test set
# (questions.yaml). The layer adds the FROM lines itself (D19).

@prefix ex: <https://ul.edu.lb/kr/lu/examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:1 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How many papers are there of each kind?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?kind (COUNT(?paper) AS ?papers) WHERE {
  ?paper pub:publicationYear ?year ; a ?kind .
} GROUP BY ?kind ORDER BY DESC(?papers)""" .

ex:2 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How many open access papers were published in 2024?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT (COUNT(?paper) AS ?papers) WHERE {
  ?paper pub:publicationYear 2024 ; pub:isOpenAccess true .
}""" .

ex:3 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which 10 venues published the most papers in 2022, and how many each?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?name (COUNT(?paper) AS ?papers) WHERE {
  ?paper pub:publicationYear 2022 ; pub:publishedIn ?venue .
  ?venue pub:name ?name .
} GROUP BY ?name ORDER BY DESC(?papers) ?name LIMIT 10""" .

ex:4 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which papers did Rim Fayad write, and in which year?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT DISTINCT ?title ?year WHERE {
  ?paper pub:hasAuthorship ?a ; pub:title ?title ; pub:publicationYear ?year .
  ?a pub:author ?person .
  ?person pub:name ?name .
  FILTER(LCASE(?name) = "rim fayad")
}""" .

ex:5 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which institutions in Italy appear on LU papers, and on how many papers each?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?name (COUNT(DISTINCT ?paper) AS ?papers) WHERE {
  ?paper pub:hasAuthorship ?a .
  ?a pub:affiliation ?institution .
  ?institution pub:countryCode "IT" ; pub:name ?name .
} GROUP BY ?name ORDER BY DESC(?papers) ?name""" .

ex:6 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "How many papers are in the domain Social Sciences?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT (COUNT(DISTINCT ?paper) AS ?papers) WHERE {
  ?paper pub:hasTopic ?topic .
  ?topic pub:domain "Social Sciences" .
}""" .

ex:7 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "What are the titles of the reviews published in 2025?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?title WHERE {
  ?paper a pub:Review ; pub:publicationYear 2025 ; pub:title ?title .
}""" .

ex:8 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "On how many papers is an LU author the corresponding author?" ;
    sh:select """PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT (COUNT(DISTINCT ?paper) AS ?papers) WHERE {
  ?paper pub:hasAuthorship ?a .
  ?a pub:affiliation <https://ul.edu.lb/kr/id/institution/openalex/I160368002> ;
     pub:isCorresponding true .
}""" .
