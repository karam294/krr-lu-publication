# CQ10. For a paper with a DOI, does a second source (Crossref) agree on its title, date and venue?
# Each OpenAlex paper with a DOI, beside the Crossref record of the same DOI (the
# key both sources share), each from its own graph.
#   title  compared without markup (tags, also escaped ones such as &lt;i&gt;),
#          entities, case, spaces and punctuation
#   year   as integers; "not comparable" when Crossref gives no date
#   day    only when both give a whole date (Crossref often gives only YYYY-MM)
#   venue  "same ISSN" when OpenAlex's linking ISSN is one of the record's
#          ISSNs; else "same name" when the names agree (the ISSN-L is often the
#          print ISSN, and Crossref lists only the electronic one; a conference
#          has no ISSN); else, when one side or both name no venue, which
PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?aspect ?answer (COUNT(*) AS ?papers)
FROM NAMED <https://ul.edu.lb/kr/graph/openalex>
FROM NAMED <https://ul.edu.lb/kr/graph/crossref>
WHERE {
  {
    SELECT ?paper ?title ?year ?date ?venue WHERE {
      GRAPH <https://ul.edu.lb/kr/graph/openalex> {
        ?paper pub:doi ?doi .
        OPTIONAL { ?paper pub:title ?t1 }
        OPTIONAL { ?paper pub:publicationYear ?y1 }
        OPTIONAL { ?paper pub:publicationDate ?d1 }
        OPTIONAL { ?paper pub:publishedIn ?v . ?v pub:name ?n1 . OPTIONAL { ?v pub:issnL ?issnL } }
      }
      GRAPH <https://ul.edu.lb/kr/graph/crossref> {
        ?record pub:doi ?doi .
        OPTIONAL { ?record pub:title ?t2 }
        OPTIONAL { ?record pub:publicationYear ?y2 }
        OPTIONAL { ?record pub:publicationDate ?d2 }
        OPTIONAL { ?record pub:venueName ?n2 }
      }
      OPTIONAL { GRAPH <https://ul.edu.lb/kr/graph/crossref> { ?record pub:issn ?i2 } FILTER (?i2 = ?issnL) }
      BIND (LCASE(REPLACE(REPLACE(REPLACE(?t1, "<[^>]*>|&(amp;)*lt;.*?&(amp;)*gt;", ""), "&(amp;)*#?[a-zA-Z0-9]+;", ""), "[^\\p{L}\\p{N}]", "")) AS ?k1)
      BIND (LCASE(REPLACE(REPLACE(REPLACE(?t2, "<[^>]*>|&(amp;)*lt;.*?&(amp;)*gt;", ""), "&(amp;)*#?[a-zA-Z0-9]+;", ""), "[^\\p{L}\\p{N}]", "")) AS ?k2)
      BIND (LCASE(REPLACE(REPLACE(REPLACE(?n1, "<[^>]*>|&(amp;)*lt;.*?&(amp;)*gt;", ""), "&(amp;)*#?[a-zA-Z0-9]+;", ""), "[^\\p{L}\\p{N}]", "")) AS ?m1)
      BIND (LCASE(REPLACE(REPLACE(REPLACE(?n2, "<[^>]*>|&(amp;)*lt;.*?&(amp;)*gt;", ""), "&(amp;)*#?[a-zA-Z0-9]+;", ""), "[^\\p{L}\\p{N}]", "")) AS ?m2)
      BIND (IF(!BOUND(?k2), "not comparable", IF(?k1 = ?k2, "same", "different")) AS ?title)
      BIND (IF(!BOUND(?y2), "not comparable", IF(?y1 = ?y2, "same", "different")) AS ?year)
      BIND (IF(!BOUND(?d1) || !BOUND(?d2), "not comparable", IF(?d1 = ?d2, "same", "different")) AS ?date)
      BIND (IF(BOUND(?i2), "same ISSN", IF(!BOUND(?m1) && !BOUND(?m2), "neither names one", IF(!BOUND(?m1), "only Crossref names one", IF(!BOUND(?m2), "only OpenAlex names one",
            IF(?m1 = ?m2, "same name", "different"))))) AS ?venue)
    }
  }
  VALUES ?aspect { "1 title" "2 year" "3 day" "4 venue" }
  BIND (IF(?aspect = "1 title", ?title, IF(?aspect = "2 year", ?year, IF(?aspect = "3 day", ?date, ?venue))) AS ?answer)
}
GROUP BY ?aspect ?answer
ORDER BY ?aspect DESC(?papers)
