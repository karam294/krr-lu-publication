# CQ7. In which languages does LU publish?
PREFIX pub: <https://ul.edu.lb/kr/pub#>
SELECT ?language (COUNT(?paper) AS ?papers)
FROM <https://ul.edu.lb/kr/graph/openalex>    # OpenAlex only: the default graph holds both sources (D14)
WHERE {
  ?paper pub:language ?language .
}
GROUP BY ?language
ORDER BY DESC(?papers) ?language