# Copy to .env (never commit .env). Gemini only: get a free key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Your own database, if the source is not the example (see docker-compose.yml):
# DB_URL=postgresql+psycopg2://user:password@db:5432/name
# OpenAlex, only to download the data again (data/fetch_openalex.py). The pipeline
# does not need it: it reads data/lu.sql (D4). Free key: https://openalex.org/settings/api
# OPENALEX_API_KEY=
   # Crossref, only to download the second source again (data/fetch_crossref.py). No key.
   # Optional: a contact address, sent only to Crossref (its "polite pool").
   # CROSSREF_MAILTO=