## mapping.ttl: our tables (data/lu.sql) to triples, in R2RML (W3C, 2012).
## pipeline/run.py runs it with Morph-KGC. One triples map per table or view;
## every IRI comes from the D3 scheme: https://ul.edu.lb/kr/id/{kind}/openalex/{key}.
## A NULL cell gives no triple (open world: not stated, not "none").
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pub: <https://ul.edu.lb/kr/pub#> .

########################################################################
## Papers: one row of works, one paper
########################################################################

<#Works>
    rr:logicalTable [ rr:tableName "works" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;

    # Plain values: copy the column.
    rr:predicateObjectMap [ rr:predicate pub:title ;
        rr:objectMap [ rr:column "title" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:doi ;
        rr:objectMap [ rr:column "doi" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:language ;
        rr:objectMap [ rr:column "language" ] ] ;

    # Values with a datatype: copy the column and say what kind of value it is.
    rr:predicateObjectMap [ rr:predicate pub:publicationYear ;
        rr:objectMap [ rr:column "publication_year" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:publicationDate ;
        rr:objectMap [ rr:column "publication_date" ; rr:datatype xsd:date ] ] ;

    # Links: the column holds another thing's key, so build that thing's IRI.
    rr:predicateObjectMap [ rr:predicate pub:publishedIn ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/venue/openalex/{source_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:hasTopic ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/topic/openalex/{topic_id}" ] ] .

## True/false: the table holds "True"/"False"; xsd:boolean is written "true"/"false".
## A logical view (an SQL query) lowers the case first.
<#WorkFlags>
    rr:logicalTable [ rr:sqlQuery """
        SELECT work_id, lower(is_oa) AS is_oa, lower(is_retracted) AS is_retracted
        FROM works""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:isOpenAccess ;
        rr:objectMap [ rr:column "is_oa" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:isRetracted ;
        rr:objectMap [ rr:column "is_retracted" ; rr:datatype xsd:boolean ] ] .

## The class: one per OpenAlex type, the 20 types of D2. A type not in this list
## gets no class, and the Session 4 shapes will report it.
<#WorkTypes>
    rr:logicalTable [ rr:sqlQuery """
        SELECT work_id, CASE type
            WHEN 'article'             THEN 'Article'
            WHEN 'conference-paper'    THEN 'ConferencePaper'
            WHEN 'preprint'            THEN 'Preprint'
            WHEN 'book-chapter'        THEN 'BookChapter'
            WHEN 'review'              THEN 'Review'
            WHEN 'other'               THEN 'OtherWork'
            WHEN 'peer-review'         THEN 'PeerReview'
            WHEN 'erratum'             THEN 'Erratum'
            WHEN 'conference-abstract' THEN 'ConferenceAbstract'
            WHEN 'book'                THEN 'Book'
            WHEN 'paratext'            THEN 'Paratext'
            WHEN 'dissertation'        THEN 'Dissertation'
            WHEN 'dataset'             THEN 'Dataset'
            WHEN 'editorial'           THEN 'Editorial'
            WHEN 'report'              THEN 'Report'
            WHEN 'book-review'         THEN 'BookReview'
            WHEN 'letter'              THEN 'Letter'
            WHEN 'data-paper'          THEN 'DataPaper'
            WHEN 'software-paper'      THEN 'SoftwarePaper'
            WHEN 'retraction'          THEN 'Retraction'
        END AS class
        FROM works""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/pub#{class}" ] ] .