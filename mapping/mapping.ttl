## mapping.ttl: our tables (data/lu.sql) to triples, in R2RML (W3C, 2012).
## pipeline/run.py runs it with Morph-KGC. One triples map per table or view;
## every IRI comes from the D3 scheme: https://ul.edu.lb/kr/id/{kind}/openalex/{key}.
## An empty cell gives no triple (open world: not stated, not "none"). A view
## (rr:sqlQuery) is used only on columns that are never empty: Morph-KGC writes
## an empty cell of a view as the text "None".
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pub: <https://ul.edu.lb/kr/pub#> .

########################################################################
## Papers: one row of works, one paper
########################################################################

<#Works>
    rr:logicalTable [ rr:tableName "works" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;

    # Plain values: copy the column.
    rr:predicateObjectMap [ rr:predicate pub:title ;
        rr:objectMap [ rr:column "title" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:doi ;
        rr:objectMap [ rr:column "doi" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:language ;
        rr:objectMap [ rr:column "language" ] ] ;

    # Values with a datatype: copy the column and say what kind of value it is.
    rr:predicateObjectMap [ rr:predicate pub:publicationYear ;
        rr:objectMap [ rr:column "publication_year" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:publicationDate ;
        rr:objectMap [ rr:column "publication_date" ; rr:datatype xsd:date ] ] ;

    # Links: the column holds another thing's key, so build that thing's IRI.
    rr:predicateObjectMap [ rr:predicate pub:publishedIn ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/venue/openalex/{source_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:hasTopic ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/topic/openalex/{topic_id}" ] ] .

## True/false: the table holds "True"/"False"; xsd:boolean is written "true"/"false".
## A logical view (an SQL query) lowers the case first.
<#WorkFlags>
    rr:logicalTable [ rr:sqlQuery """
        SELECT work_id, lower(is_oa) AS is_oa, lower(is_retracted) AS is_retracted
        FROM works""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:isOpenAccess ;
        rr:objectMap [ rr:column "is_oa" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:isRetracted ;
        rr:objectMap [ rr:column "is_retracted" ; rr:datatype xsd:boolean ] ] .

## The class: one per OpenAlex type, the 20 types of D2. A type not in this list
## gets no class (the outer WHERE drops it), and the Session 4 shapes will report it.
<#WorkTypes>
    rr:logicalTable [ rr:sqlQuery """
        SELECT work_id, class FROM (SELECT work_id, CASE type
            WHEN 'article'             THEN 'Article'
            WHEN 'conference-paper'    THEN 'ConferencePaper'
            WHEN 'preprint'            THEN 'Preprint'
            WHEN 'book-chapter'        THEN 'BookChapter'
            WHEN 'review'              THEN 'Review'
            WHEN 'other'               THEN 'OtherWork'
            WHEN 'peer-review'         THEN 'PeerReview'
            WHEN 'erratum'             THEN 'Erratum'
            WHEN 'conference-abstract' THEN 'ConferenceAbstract'
            WHEN 'book'                THEN 'Book'
            WHEN 'paratext'            THEN 'Paratext'
            WHEN 'dissertation'        THEN 'Dissertation'
            WHEN 'dataset'             THEN 'Dataset'
            WHEN 'editorial'           THEN 'Editorial'
            WHEN 'report'              THEN 'Report'
            WHEN 'book-review'         THEN 'BookReview'
            WHEN 'letter'              THEN 'Letter'
            WHEN 'data-paper'          THEN 'DataPaper'
            WHEN 'software-paper'      THEN 'SoftwarePaper'
            WHEN 'retraction'          THEN 'Retraction'
        END AS class
        FROM works) AS typed WHERE class IS NOT NULL""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/pub#{class}" ] ] .

########################################################################
## Authorships: one row of authorships, one author on one paper. It has no ID
## of its own, so its key is paper + byline position (D3).
########################################################################

<#Authorships>
    rr:logicalTable [ rr:tableName "authorships" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/authorship/openalex/{work_id}-{author_order}" ;
                    rr:class pub:Authorship ] ;
    rr:predicateObjectMap [ rr:predicate pub:authorOrder ;
        rr:objectMap [ rr:column "author_order" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:authorPosition ;
        rr:objectMap [ rr:column "author_position" ] ] ;
    # The name as printed on this paper: every authorship has one, also the
    # 2,101 with no OpenAlex author ID (D5).
    rr:predicateObjectMap [ rr:predicate pub:nameAsListed ;
        rr:objectMap [ rr:column "author_name" ] ] ;
    # The person: only when OpenAlex gives an author ID (an empty cell, no triple).
    rr:predicateObjectMap [ rr:predicate pub:author ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/author/openalex/{author_id}" ] ] .

## True/false, lowered as for papers. Only columns that are never empty go in a
## view: Morph-KGC turns an empty cell of a view into the text "None".
<#AuthorshipFlags>
    rr:logicalTable [ rr:sqlQuery """
        SELECT work_id, author_order, lower(is_corresponding) AS is_corresponding
        FROM authorships""" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/authorship/openalex/{work_id}-{author_order}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:isCorresponding ;
        rr:objectMap [ rr:column "is_corresponding" ; rr:datatype xsd:boolean ] ] .

## The paper points to each of its authorships.
<#PaperAuthorships>
    rr:logicalTable [ rr:tableName "authorships" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:hasAuthorship ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/authorship/openalex/{work_id}-{author_order}" ] ] .

## Affiliations: one row, one institution of one authorship. The institution
## belongs to the author on this paper, not to the author forever.
<#Affiliations>
    rr:logicalTable [ rr:tableName "affiliations" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/authorship/openalex/{work_id}-{author_order}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:affiliation ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/institution/openalex/{institution_id}" ] ] .

########################################################################
## Authors: one row of authors, one person (only those with an OpenAlex ID)
########################################################################

<#Authors>
    rr:logicalTable [ rr:tableName "authors" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/author/openalex/{author_id}" ;
                    rr:class pub:Author ] ;
    rr:predicateObjectMap [ rr:predicate pub:name ;
        rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:orcid ;
        rr:objectMap [ rr:column "orcid" ] ] .

########################################################################
## Institutions, venues and topics: one row each, one thing each
########################################################################

<#Institutions>
    rr:logicalTable [ rr:tableName "institutions" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/institution/openalex/{institution_id}" ;
                    rr:class pub:Institution ] ;
    rr:predicateObjectMap [ rr:predicate pub:name ;
        rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:countryCode ;
        rr:objectMap [ rr:column "country_code" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:institutionType ;
        rr:objectMap [ rr:column "type" ] ] .

## A venue is where a paper appeared: a journal, a conference, a repository.
## OpenAlex calls it a "source"; D3 calls the kind "venue", so that "source"
## keeps one meaning in this project: the system the data came from.
<#Venues>
    rr:logicalTable [ rr:tableName "sources" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/venue/openalex/{source_id}" ;
                    rr:class pub:Venue ] ;
    rr:predicateObjectMap [ rr:predicate pub:name ;
        rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:issnL ;
        rr:objectMap [ rr:column "issn_l" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:venueType ;
        rr:objectMap [ rr:column "type" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:publisher ;
        rr:objectMap [ rr:column "publisher" ] ] .

## A topic, with the three levels above it as text for now (subfield, field,
## domain). Whether they become things of their own is a Session 3 question.
<#Topics>
    rr:logicalTable [ rr:tableName "topics" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/topic/openalex/{topic_id}" ;
                    rr:class pub:Topic ] ;
    rr:predicateObjectMap [ rr:predicate pub:name ;
        rr:objectMap [ rr:column "name" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:subfield ;
        rr:objectMap [ rr:column "subfield" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:field ;
        rr:objectMap [ rr:column "field" ] ] ;
    rr:predicateObjectMap [ rr:predicate pub:domain ;
        rr:objectMap [ rr:column "domain" ] ] .    

        
########################################################################
## Citations: one row of citations, one paper citing another. The cited paper
## gets the same IRI template as our papers, so a citation to one of our
## 5,211 lands on its node; any other cited paper is a node we know only by name.
########################################################################

<#Citations>
    rr:logicalTable [ rr:tableName "citations" ] ;
    rr:subjectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{citing_work_id}" ] ;
    rr:predicateObjectMap [ rr:predicate pub:cites ;
        rr:objectMap [ rr:template "https://ul.edu.lb/kr/id/work/openalex/{cited_work_id}" ] ] .            