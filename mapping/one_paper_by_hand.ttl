@prefix topic:      <https://ul.edu.lb/kr/id/topic/openalex/> .

# ---- the paper: one row of works.csv ----
work:W3023054831 a pub:Article ;
    pub:title "Stochastic Homogenization of Hamilton–Jacobi Equations on a Junction" ;
    pub:doi "10.1007/s00205-021-01737-1" ;
    pub:publicationYear 2022 ;
    pub:publicationDate "2022-01-22"^^xsd:date ;
    pub:language "en" ;
    pub:isOpenAccess true ;
    pub:isRetracted false ;
    pub:publishedIn venue:S136982523 ;
    pub:hasTopic topic:T12100 ;
    pub:hasAuthorship authorship:W3023054831-1 ,
                      authorship:W3023054831-2 ,
                      authorship:W3023054831-3 ;
    # 3 of its 32 references (citations.csv), enough to see the idea
    pub:cites work:W1126041682 , work:W1164997633 , work:W1530546387 .

